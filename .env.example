# Copy to .env and fill in. Never commit .env. All three services have a free tier.

# The phone number, the call rooms and browser audio. https://cloud.livekit.io > Settings > API keys
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The language model. https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Speech to text and text to speech. https://console.deepgram.com
DEEPGRAM_API_KEY=
